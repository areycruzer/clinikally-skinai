# === Clinikally SkinAI — Environment Configuration ===
# Copy this file to .env and fill in your values.

# === WEAVIATE CLOUD ===
WCD_URL=https://your-cluster.weaviate.cloud
WCD_API_KEY=your-weaviate-api-key
WEAVIATE_IS_LOCAL=False

# === LLM MODELS (via OpenRouter) ===
# These are the base and complex models used by the decision tree agent.
# The base model handles routing decisions; the complex model generates final responses.
BASE_MODEL=openai/gpt-oss-120b:free
BASE_PROVIDER=openrouter
COMPLEX_MODEL=openai/gpt-oss-120b:free
COMPLEX_PROVIDER=openrouter

# === API KEYS ===
# OpenRouter provides access to many LLMs through a single API.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Gemini API key for multimodal skin photo analysis (vision).
GEMINI_API_KEY=AIza...

# Optional: Direct API keys for other providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# === SYSTEM ===
FIRST_START_ELYSIA='1'